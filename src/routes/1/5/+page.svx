<script lang="ts">
  import LessonShell from '$lib/components/LessonShell.svelte';
  import KarelEnvironment from '$lib/components/KarelEnvironment.svelte';
  import type { KarelConfig, KarelWorld, Wall } from '$lib/karel/types';

  // ── Shared helpers ─────────────────────────────────────────────────────────

  /** The generous command set used by the first two exercises (sensors included). */
  const allCommands = [
    'move', 'turn_left', 'put_beeper', 'pick_beeper',
    'front_is_clear', 'front_is_blocked',
    'beepers_present', 'no_beepers_present',
    'facing_north', 'not_facing_north',
    'facing_south', 'not_facing_south',
    'facing_east', 'not_facing_east',
    'facing_west', 'not_facing_west'
  ];

  /** Movement plus front sensors only — used by the warehouse exercises. */
  const countingCommands = [
    'move', 'turn_left', 'put_beeper', 'pick_beeper',
    'front_is_clear', 'front_is_blocked'
  ];

  /** An empty world of the given size with Karel at (2, 2) facing east. */
  function emptyWorld(width: number, height: number): KarelWorld {
    return {
      dimensions: { width, height },
      karel: {
        position: { x: 2, y: 2 },
        direction: { type: 'east' },
        beepers: -1
      },
      walls: [],
      beepers: []
    };
  }

  /** Aisle columns Karel can stand in: 1, 4, 7, ... — each with a shelf to its east. */
  function aisleColumns(width: number): number[] {
    const columns: number[] = [];
    for (let x = 1; x + 1 <= width; x += 3) columns.push(x);
    return columns;
  }

  /** The rows of a shelf's cubbies. */
  const cubbyRows = [2, 3, 4, 5];

  /**
   * One shelf, standing east of `aisle`: four cubbies stacked at rows 2-5,
   * each with a board above and below it and a back wall on the east, so the
   * only way in is a step east out of the aisle.
   */
  function shelfWalls(aisle: number): Wall[] {
    const shelf = aisle + 1;
    const walls: Wall[] = [];
    for (const y of cubbyRows) walls.push({ type: 'vertical', x: shelf, y });
    for (let y = 2; y <= 6; y++) walls.push({ type: 'horizontal', x: shelf, y });
    return walls;
  }

  /**
   * A warehouse with `shelfCount` shelves: a corridor along row 1, an aisle at
   * every third column (1, 4, 7, ...), and a shelf east of each one. A wall in
   * the corridor east of the last aisle marks the end of the run — the world
   * itself carries on past it.
   */
  function warehouse(shelfCount: number): KarelWorld {
    const width = shelfCount * 3;
    const aisles = aisleColumns(width);
    return {
      dimensions: { width, height: 7 },
      karel: {
        position: { x: 1, y: 1 },
        direction: { type: 'east' },
        beepers: -1
      },
      walls: [
        ...aisles.flatMap((a) => shelfWalls(a)),
        { type: 'vertical', x: aisles[aisles.length - 1], y: 1 }
      ],
      beepers: []
    };
  }

  /** The same warehouse, with Karel parked in a different aisle. */
  function warehouseAt(shelfCount: number, aisle: number): KarelWorld {
    const world = warehouse(shelfCount);
    return { ...world, karel: { ...world.karel, position: { x: aisle, y: 1 } } };
  }

  // ── Examples ───────────────────────────────────────────────────────────────

  // Example 1: Counting in an open field, where sensors tell you nothing
  const openFieldExample: KarelConfig = {
    initialWorld: {
      dimensions: { width: 9, height: 9 },
      karel: {
        position: { x: 2, y: 2 },
        direction: { type: 'east' },
        beepers: -1
      },
      walls: [],
      beepers: []
    },
    initialCode: `# Mark the spot exactly 4 east and 4 north of here.
# There is no wall out here to stop Karel,
# so counting is the only way to find it.

for i in range(4):
  move()

turn_left()

for i in range(4):
  move()

put_beeper()
`
  };

  // Example 2: A known-size job repeated an unknown number of times
  const bulbsExample: KarelConfig = {
    initialWorld: {
      dimensions: { width: 10, height: 1 },
      karel: {
        position: { x: 1, y: 1 },
        direction: { type: 'east' },
        beepers: -1
      },
      walls: [],
      beepers: []
    },
    initialCode: `# Plant 3 bulbs every third cell along the walkway.
# The walkway length is unknown -> while loop.
# Each planting is always 3 bulbs -> for loop.

def plant():
  for i in range(3):
    put_beeper()

plant()
while front_is_clear():
  for i in range(3):
    move()
  plant()
`
  };

  // ── Exercise 1: Stake the claim ────────────────────────────────────────────

  const claimCorners = [
    { x: 2, y: 2 },
    { x: 6, y: 2 },
    { x: 6, y: 6 },
    { x: 2, y: 6 }
  ];

  const exercise1Config: KarelConfig = {
    persistenceKey: '1/5/exercise-1',
    initialWorld: emptyWorld(9, 9),
    initialCode: `# Karel the surveyor is marking out a claim
# on open prairie.
#
# Drive a stake into all four corners of a square
# that is 5 cells on a side, with Karel's starting
# cell as the southwest corner.
#
# Karel always starts at (2, 2) facing east, and
# the prairie is always big enough for the claim —
# but the prairie is a different size every time.
#
# Finish back on the starting stake, facing east.

`,
    allowedFeatures: {
      karelCommands: allCommands
    },
    tests: {
      worlds: {
        'Test 1: 9x9 prairie': emptyWorld(9, 9),
        'Test 2: 12x10 prairie': emptyWorld(12, 10),
        'Test 3: 7x7 prairie (barely fits)': emptyWorld(7, 7)
      },
      validate: (world) => {
        const onGround = world.beepers.filter((b) => b.count > 0);
        const missing = claimCorners.filter(
          (c) => !onGround.find((b) => b.x === c.x && b.y === c.y)
        );
        const strays = onGround.filter(
          (b) => !claimCorners.find((c) => c.x === b.x && c.y === b.y)
        );

        if (missing.length > 0) {
          const list = missing.map((c) => `(${c.x}, ${c.y})`).join(', ');
          return { passed: false, message: `No stake at ${list}.` };
        }
        if (strays.length > 0) {
          const list = strays.map((b) => `(${b.x}, ${b.y})`).join(', ');
          return {
            passed: false,
            message: `Stakes dropped outside the corners: ${list}. The claim has exactly four.`
          };
        }
        const { x, y } = world.karel.position;
        if (x !== 2 || y !== 2) {
          return {
            passed: false,
            message: `Karel needs to finish back at (2, 2) but ended at (${x}, ${y}).`
          };
        }
        if (world.karel.direction.type !== 'east') {
          return {
            passed: false,
            message: `Karel is facing ${world.karel.direction.type} — a full lap around the claim ends facing east.`
          };
        }
        return {
          passed: true,
          message: 'Claim staked out! The same counts worked on every prairie.'
        };
      },
      loadableTests: [
        'Test 1: 9x9 prairie',
        'Test 2: 12x10 prairie',
        'Test 3: 7x7 prairie (barely fits)'
      ]
    }
  };

  // ── Exercise 2: Paint the kitchen ──────────────────────────────────────────

  /** The non-volley zone: 5 wide, 3 deep, anchored at Karel's start. */
  const kitchenCells: { x: number; y: number }[] = [];
  for (let y = 2; y <= 4; y++) {
    for (let x = 2; x <= 6; x++) {
      kitchenCells.push({ x, y });
    }
  }

  const exercise2Config: KarelConfig = {
    persistenceKey: '1/5/exercise-2',
    initialWorld: emptyWorld(10, 8),
    initialCode: `# Pickleball Karel is painting the kitchen —
# the non-volley zone of a backyard court.
#
# Paint (put a beeper on) every cell of a rectangle
# 5 wide and 3 deep, with Karel's starting cell as
# the southwest corner. That is 15 cells in all.
#
# Karel always starts at (2, 2) facing east, and the
# yard is always big enough — but its size changes.
#
# Finish back on the starting cell.

`,
    allowedFeatures: {
      karelCommands: allCommands
    },
    tests: {
      worlds: {
        'Test 1: 10x8 yard': emptyWorld(10, 8),
        'Test 2: 12x9 yard': emptyWorld(12, 9),
        'Test 3: 7x5 yard (barely fits)': emptyWorld(7, 5)
      },
      validate: (world) => {
        const onGround = world.beepers.filter((b) => b.count > 0);
        const missing = kitchenCells.filter(
          (c) => !onGround.find((b) => b.x === c.x && b.y === c.y)
        );
        const strays = onGround.filter(
          (b) => !kitchenCells.find((c) => c.x === b.x && c.y === b.y)
        );

        if (missing.length > 0) {
          const list = missing
            .slice(0, 4)
            .map((c) => `(${c.x}, ${c.y})`)
            .join(', ');
          const more = missing.length > 4 ? `, and ${missing.length - 4} more` : '';
          return {
            passed: false,
            message: `${missing.length} unpainted cell(s): ${list}${more}.`
          };
        }
        if (strays.length > 0) {
          const list = strays.map((b) => `(${b.x}, ${b.y})`).join(', ');
          return {
            passed: false,
            message: `Paint spilled outside the kitchen at ${list}.`
          };
        }
        const { x, y } = world.karel.position;
        if (x !== 2 || y !== 2) {
          return {
            passed: false,
            message: `The kitchen is painted, but Karel needs to finish back at (2, 2) — currently at (${x}, ${y}).`
          };
        }
        return {
          passed: true,
          message: 'Kitchen painted, all 15 cells, in every yard. Nice nesting!'
        };
      },
      loadableTests: ['Test 1: 10x8 yard', 'Test 2: 12x9 yard', 'Test 3: 7x5 yard (barely fits)']
    }
  };

  // ── Exercise 3: Stock one shelf ────────────────────────────────────────────

  /** Checks the four cubbies of the shelf beside `aisle`, plus Karel's final state. */
  function validateOneShelf(world: KarelWorld, aisle: number) {
    const shelf = aisle + 1;
    const onGround = world.beepers.filter((b) => b.count > 0);
    const missing = cubbyRows.filter(
      (y) => !onGround.find((b) => b.x === shelf && b.y === y)
    );
    const strays = onGround.filter((b) => b.x !== shelf || !cubbyRows.includes(b.y));

    if (missing.length > 0) {
      return {
        passed: false,
        message: `No crate in the cubby at row(s) ${missing.join(', ')} of the shelf in column ${shelf}.`
      };
    }
    if (strays.length > 0) {
      const list = strays.map((b) => `(${b.x}, ${b.y})`).join(', ');
      return {
        passed: false,
        message: `Crates left outside the cubbies at ${list}. A shelf takes exactly four.`
      };
    }
    const { x, y } = world.karel.position;
    if (x !== aisle || y !== 1) {
      return {
        passed: false,
        message: `Karel must return to the corridor at (${aisle}, 1) but ended at (${x}, ${y}).`
      };
    }
    if (world.karel.direction.type !== 'east') {
      return {
        passed: false,
        message: `Karel must end facing east, not ${world.karel.direction.type}.`
      };
    }
    return {
      passed: true,
      message: `Shelf in column ${shelf} is stocked and Karel is back in the corridor.`
    };
  }

  const oneShelfWorld = warehouse(1);

  const exercise3Config: KarelConfig = {
    persistenceKey: '1/5/exercise-3',
    initialWorld: oneShelfWorld,
    initialCode: `# Every shelf in the warehouse needs the same job
# done: a crate in each of its 4 cubbies.
#
# Write stock_shelf() and call it.
#
# stock_shelf()
#   Pre:  Karel is in an aisle (row 1) beside a shelf,
#         facing east
#   Post: a crate in each of the shelf's 4 cubbies,
#         and Karel is back where it started, facing east
#
# The cubbies only open onto the aisle, so Karel has to
# step in and back out again for each one.
#
# Careful: the shelf is 4 cubbies tall, but the aisle
# runs well past it. Count — do not walk until
# something stops you.

def stock_shelf():
  pass

stock_shelf()
`,
    allowedFeatures: {
      karelCommands: countingCommands
    },
    tests: {
      worlds: {
        'Shelf beside aisle 1': oneShelfWorld
      },
      validate: (world) => validateOneShelf(world, 1),
      validateCode: {
        name: 'Defined and called stock_shelf()',
        validate: (code) => {
          const defines = /def\s+stock_shelf\s*\(/.test(code);
          const calls = code
            .split('\n')
            .some((line) => /^\s*stock_shelf\s*\(/.test(line) && !/^\s*def\s/.test(line));
          if (!defines) {
            return { passed: false, message: 'You must define a function named stock_shelf().' };
          }
          if (!calls) {
            return { passed: false, message: 'Define stock_shelf() and then call it.' };
          }
          return { passed: true, message: '' };
        }
      },
      functionTests: [
        {
          name: 'stock_shelf() works from the second aisle',
          functionName: 'stock_shelf',
          world: warehouseAt(2, 4),
          validate: (world) => validateOneShelf(world, 4)
        },
        {
          name: 'stock_shelf() works from the third aisle',
          functionName: 'stock_shelf',
          world: warehouseAt(3, 7),
          validate: (world) => validateOneShelf(world, 7)
        }
      ]
    }
  };

  // ── Exercise 4: Restock the warehouse ──────────────────────────────────────

  const exercise4Config: KarelConfig = {
    persistenceKey: '1/5/exercise-4',
    initialWorld: warehouse(3),
    initialCode: `# Restock night. Every shelf in the warehouse needs
# the same four crates.
#
# The corridor runs along row 1. An aisle opens off
# the corridor at column 1, and at every third column
# after that (1, 4, 7, ...), with a shelf standing
# beside each one.
#
# You do NOT know how many shelves there are.
# You DO know that every shelf has exactly 4 cubbies,
# that the aisles are exactly 3 columns apart, and
# that a wall in the corridor marks the end of the run.
#
# Karel starts at (1, 1) facing east with unlimited
# crates. Stock every shelf.

`,
    allowedFeatures: {
      karelCommands: countingCommands
    },
    tests: {
      worlds: {
        'Test 1: 3 shelves': warehouse(3),
        'Test 2: 2 shelves': warehouse(2),
        'Test 3: 5 shelves': warehouse(5),
        'Test 4: 1 shelf': warehouse(1),
        'Test 5: 4 shelves': warehouse(4)
      },
      validate: (world) => {
        const shelves = aisleColumns(world.dimensions.width).map((a) => a + 1);
        const onGround = world.beepers.filter((b) => b.count > 0);

        const missing: string[] = [];
        for (const s of shelves) {
          for (const y of cubbyRows) {
            if (!onGround.find((b) => b.x === s && b.y === y)) missing.push(`(${s}, ${y})`);
          }
        }
        const strays = onGround.filter(
          (b) => !shelves.includes(b.x) || !cubbyRows.includes(b.y)
        );

        if (missing.length > 0) {
          const list = missing.slice(0, 4).join(', ');
          const more = missing.length > 4 ? `, and ${missing.length - 4} more` : '';
          return {
            passed: false,
            message: `${shelves.length} shelf/shelves in this warehouse. Empty cubbies at ${list}${more}.`
          };
        }
        if (strays.length > 0) {
          const list = strays
            .slice(0, 4)
            .map((b) => `(${b.x}, ${b.y})`)
            .join(', ');
          return {
            passed: false,
            message: `Crates dropped outside the cubbies at ${list}. Nothing belongs in the corridor or the aisles.`
          };
        }
        return {
          passed: true,
          message: `All ${shelves.length} shelf/shelves stocked — and the same code handles a warehouse of any size.`
        };
      },
      loadableTests: [
        'Test 1: 3 shelves',
        'Test 2: 2 shelves',
        'Test 3: 5 shelves',
        'Test 4: 1 shelf'
      ]
    }
  };
</script>

<LessonShell chapterNumber={1} lessonNumber={5}>

## Counting Instead of Sensing

While loops ask the world a question: *is the front clear? are there beepers here?* Karel repeats until the answer changes. That works beautifully — as long as there is something out there to sense.

Now picture Karel standing in the middle of a wide open field. No walls nearby, no beepers, nothing. The job is to walk exactly four cells east. Ask `front_is_clear()` and the answer is *yes* — and it is still *yes* after four steps, and after ten, and it stays *yes* until Karel slams into a wall that has nothing to do with the task.

The world has no idea where you were going. **You** know the count. A **for loop** is how you spend that knowledge instead of hunting for a landmark that isn't there.

## The For Loop

```python
for i in range(4):
  move()
```

This means: **"Do `move()` exactly 4 times."**

- **`for i in range(4):`** — sets up a loop that runs 4 times
- **`range(4)`** — produces the numbers 0, 1, 2, 3 (four of them)
- **`i`** — the loop variable. Something the loop needs; we'll talk about it in more detail in a later chapter
- **The indented code** — what gets repeated

> **Tip:** `range(n)` runs the loop `n` times. `range(3)` runs 3 times, `range(10)` runs 10 times.

Notice there is no condition anywhere. Nothing gets checked, nothing gets sensed. The loop simply counts, and when the count runs out, it stops.

## Example: No Landmarks, No Problem

Karel is standing in a big empty field and needs to mark the spot four east and four north. Run it, and imagine what `while front_is_clear(): move()` would have done instead — Karel would have sailed straight past the mark and stopped at a wall eight cells away.

<KarelEnvironment config={openFieldExample} />

---

## For Loops Inside Functions

Remember `turn_right()`? Three left turns, written out three times. A for loop says it better:

```python
def turn_right():
  for i in range(3):
    turn_left()
```

And its sibling, which you will want constantly:

```python
def turn_around():
  for i in range(2):
    turn_left()
```

These are the smallest useful for loops you will ever write, and they are worth keeping in your toolkit for the rest of the chapter.

---

## For and While Are Partners

It is tempting to treat these as rivals. They are not. They answer different questions:

| | For loop | While loop |
| --- | --- | --- |
| **Knows how many** | Yes, before it starts | No |
| **Knows when to stop** | When the count runs out | When the world says so |
| **Needs sensors** | No | Yes |
| **Good for** | A job of a known size | A job of an unknown size |

The interesting programs use both at once, because real jobs are usually **an unknown number of known things**. You do not know how many rooms are in the building, but you know every room has four walls. You do not know how many customers are in line, but you know every customer gets one receipt.

That shape has a name worth remembering: a `while` loop on the outside for the part you cannot predict, and a `for` loop on the inside for the part you can.

## Example: Known Job, Unknown Count

Karel plants three bulbs every third cell along a walkway. The walkway could be any length — that is the while loop's problem. Every planting is exactly three bulbs and every gap is exactly three steps — that is the for loop's problem.

<KarelEnvironment config={bulbsExample} />

Note the fencepost pattern again: the first planting happens *before* the loop, and each trip through the loop moves and then plants.

A loop inside a loop is called **nesting**, and nothing about this particular pairing is special. Any loop can go inside any other loop, as deep as the job needs — a `for` inside a `while`, a `for` inside a `for`, a `while` inside a `for`, three layers deep if that is what it takes. Each loop only ever asks its own question: *how many times?* or *are we there yet?*

---

## Exercise 1: Surveying the Homestead

Karel is a land surveyor marking out a claim on open prairie, and the first job is driving a stake into each of the four corners.

The claim is a square **5 cells on a side**, with Karel's starting cell as its southwest corner. Karel always starts at **(2, 2) facing east** with unlimited stakes, and the prairie is always big enough — but it is a **different size in every test**, and out here there is no landmark at a reliable distance to steer by.

Place a stake on all four corners and finish back on the starting stake, facing east. Load the other test worlds from the dropdown to confirm your counts hold up.

<KarelEnvironment config={exercise1Config} />

---

## Exercise 2: Paint the Kitchen

Pickleball Karel is putting a court in the back yard, and the non-volley zone — the "kitchen" — needs painting. It is a rectangle **5 wide and 3 deep**, with Karel's starting cell as its southwest corner. Put a beeper on all 15 cells, then finish back on the starting cell.

Karel always starts at **(2, 2) facing east** with unlimited paint, and the yard is a different size in every test.

This one wants a for loop inside a for loop, plus a couple of helper functions to keep it readable. Count carefully in both directions — a row of cells takes fewer moves than it has cells, and the same is true of the rows themselves. Think about how Karel gets from the end of one row to the start of the next, and make sure that trip does not happen after the final row.

<KarelEnvironment config={exercise2Config} />

---

## Exercise 3: Stock One Shelf

Karel works the night shift in a warehouse. Aisles run north off the main corridor, and beside each aisle stands a shelf: **four cubbies** stacked one above another, boarded off from each other and walled at the back.

That leaves a cubby exactly one opening — the side facing the aisle. So Karel walks up the aisle and, at each cubby, steps in, drops a crate, and backs out again. Write a function that handles exactly one shelf:

```python
# stock_shelf()
#   Pre:  Karel is in an aisle (row 1) beside a shelf, facing east
#   Post: a crate in each of the shelf's 4 cubbies,
#         and Karel is back where it started, facing east
```

Write it, call it, and mind the pre/post conditions — the next exercise depends on this function working from *anywhere* in the corridor, so it is tested from more than one aisle.

> **Watch out:** the shelf is 4 cubbies tall, but the aisle **runs well past it**. Walking north until something blocks you takes Karel two cells too far. Count.

<KarelEnvironment config={exercise3Config} />

---

## Exercise 4: Restock the Warehouse

Time to do the whole building.

The corridor runs along row 1. An aisle opens off the corridor at column 1 and at **every third column** after that — columns 1, 4, 7, and so on — with a shelf standing beside each one. Karel starts at **(1, 1) facing east**, already in the first aisle, with unlimited crates.

Here is the catch, and the point of the whole lesson:

- You **do not** know how many shelves there are. The warehouse can be any size.
- You **do** know that every shelf has exactly 4 cubbies, and that the aisles are exactly 3 columns apart.

A wall across the corridor marks the end of the run. The warehouse floor carries on past it, so it is that wall — not the edge of the world — that tells Karel when to stop.

Stock every shelf in the warehouse. Reuse `stock_shelf()` from Exercise 3 — paste it in and build around it.

Think about which part of the job each kind of loop owns, and remember the fencepost: the first shelf needs attention before the loop ever runs. The dropdown holds four sample warehouses, including a one-shelf warehouse that breaks careless solutions; your code is checked against another warehouse you cannot see.

<KarelEnvironment config={exercise4Config} />

---

## What You Learned

In this lesson you learned:

- **For loops** repeat code a fixed number of times with `for i in range(n):` — no condition, no sensing
- For loops are the right tool when **you** hold the count and the world offers no landmark
- **Loops nest** in any combination and to any depth — a `for` in a `while`, a `for` in a `for`, whatever the job needs
- The fencepost problem follows you into for loops — count the gaps, not just the items
- **`while` outside, `for` inside** is the pattern for an unknown number of known things

In the next lesson, you'll learn about **if/else statements** — making Karel choose different actions based on its surroundings.

</LessonShell>
